# Copy to .env and fill in. Used by docker-compose.

# Pilot customer account (position + geozones + on-demand refresh)
PILOT_BASE=https://pilot-gps.com
PILOT_USER=wbin@aimsgroup.com
PILOT_PASS=change-me

# Dashboard login + security
APP_SECRET=generate-a-long-random-string
DASHBOARD_USER=aims
DASHBOARD_PASS=change-me
DB_PASSWORD=set-a-strong-db-password

# Background refresh cadence
POLL_INTERVAL_MINUTES=180

# First-run seed (set SEED=1 once, then back to 0). Requires seed-data/ mounted.
SEED=0

# OPTIONAL — admin feed for per-point angle history (lift detection from API).
# Kvadrat admin credentials; leave blank to run position-only.
PILOT_ADMIN_URL=
PILOT_ADMIN_USER=
PILOT_ADMIN_PASS=
